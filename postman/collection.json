{
	"info": {
		"name": "Khishig - Lab11b API",
		"description": "F.CSM311 - Lab14 Assignment API Tests",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"description": "Хэрэглэгч бүртгэх болон нэвтрэх",
			"item": [
				{
					"name": "1. Register User",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.environment.set(\"randomUser\", \"user_\" + Math.floor(Math.random() * 10000));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Response time is below 1000ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(1000);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{randomUser}}\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"register"
							]
						},
						"description": "Шинэ хэрэглэгч бүртгэх"
					}
				},
				{
					"name": "2. Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 (Success) or 401 (Fail)\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
									"});",
									"pm.test(\"Response has token\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('token');",
									"    pm.environment.set('token', jsonData.token);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{randomUser}}\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"login"
							]
						},
						"description": "Бүртгүүлсэн хэрэглэгчээр нэвтрэх"
					}
				}
			]
		},
		{
			"name": "Products",
			"description": "Бүтээгдэхүүн удирдах үйлдлүүд",
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{token}}",
						"type": "string"
					}
				]
			},
			"item": [
				{
					"name": "3. Get All Products (Happy GET)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Content-Type is JSON\", function () {",
									"    pm.response.to.have.header(\"Content-Type\");",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/products",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products"
							]
						},
						"description": "Бүх бүтээгдэхүүний жагсаалт авах"
					}
				},
				{
					"name": "4. Create Product (POST)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.environment.set(\"productPrice\", Math.floor(Math.random() * 500) + 10);"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Response has id property\", function () {",
									"    pm.expect(jsonData).to.have.property(\"id\");",
									"});",
									"pm.test(\"Value type: id is number\", function () {",
									"    pm.expect(jsonData.id).to.be.a(\"number\");",
									"});",
									"pm.test(\"Business rule: Price is valid\", function () {",
									"    pm.expect(jsonData.price).to.be.above(0);",
									"});",
									"if(jsonData.id) {",
									"    pm.environment.set(\"createdProductId\", jsonData.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Smart Watch\",\n  \"description\": \"New generation watch\",\n  \"price\": {{productPrice}},\n  \"stock\": 100\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/products",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products"
							]
						},
						"description": "Шинэ бүтээгдэхүүн үүсгэх"
					}
				},
				{
					"name": "5. Get Product By ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Product ID matches chained variable\", function () {",
									"    pm.expect(jsonData.id).to.eql(pm.environment.get(\"createdProductId\"));",
									"});",
									"// JSON Schema validation",
									"var schema = {",
									"    \"type\": \"object\",",
									"    \"properties\": {",
									"        \"id\": {\"type\": \"number\"},",
									"        \"name\": {\"type\": \"string\"},",
									"        \"price\": {\"type\": \"number\"}",
									"    },",
									"    \"required\": [\"id\", \"name\", \"price\"]",
									"};",
									"pm.test(\"Schema is valid\", function () {",
									"    pm.response.to.have.jsonSchema(schema);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/products/{{createdProductId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products",
								"{{createdProductId}}"
							]
						},
						"description": "ID-гаар бүтээгдэхүүн хайх"
					}
				},
				{
					"name": "6. Update Product (PUT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Name was updated\", function () {",
									"    pm.expect(jsonData.name).to.eql(\"Updated Smart Watch\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Updated Smart Watch\",\n  \"description\": \"Updated description\",\n  \"price\": 199.99,\n  \"stock\": 50\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/products/{{createdProductId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products",
								"{{createdProductId}}"
							]
						},
						"description": "Бүтээгдэхүүний мэдээлэл засах"
					}
				},
				{
					"name": "7. Delete Product",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 204 No Content\", function () {",
									"    pm.response.to.have.status(204);",
									"});",
									"pm.environment.unset(\"createdProductId\");"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/products/{{createdProductId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products",
								"{{createdProductId}}"
							]
						},
						"description": "Бүтээгдэхүүн устгах"
					}
				}
			]
		},
		{
			"name": "Errors & Negative Tests",
			"description": "Алдаа заах нөхцөлүүд (Negative Tests)",
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{token}}",
						"type": "string"
					}
				]
			},
			"item": [
				{
					"name": "8. Get Non-existent Product (404)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 404 Not Found\", function () {",
									"    pm.response.to.have.status(404);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/products/999999",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products",
								"999999"
							]
						},
						"description": "Байхгүй ID-гаар хайх"
					}
				},
				{
					"name": "9. Unauthorized Create Product (401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401 Unauthorized\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"pm.test(\"Error message is returned\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('error');",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Unauthorized Product\",\n  \"price\": 100\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/products",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products"
							]
						},
						"description": "Token-гүйгээр бүтээгдэхүүн үүсгэх оролдлого - 401 буцаах ёстой"
					}
				}
			]
		}
	]
}
